# Rosmaster robot — udev rules for all USB devices
# Copy to /etc/udev/rules.d/ with:
#   sudo cp rosmaster.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger

# Orbbec Astra / depth cameras (vendor 2bc5)
# Creates: /dev/astra
SUBSYSTEM=="usb", ATTR{idProduct}=="060f", ATTR{idVendor}=="2bc5", MODE:="0666", OWNER:="root", GROUP:="video", SYMLINK+="astra"

# The video stream 
# Creates: /dev/astra_rgb
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="2bc5", ATTRS{idProduct}=="050f", ATTR{name}=="USB 2.0 Camera", MODE="0666", OWNER="root", GROUP="video", SYMLINK+="astra_rgb"

#  RPLidar A1 / CP2102 USB-to-Serial
# Creates: /dev/rplidar
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", OWNER:="root", GROUP:="dialout", SYMLINK+="rplidar"

# Rosmaster Motor Board (if using USB-serial)
# Creates: /dev/rosmaster
KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE:="0666", SYMLINK+="rosmaster_driver"
